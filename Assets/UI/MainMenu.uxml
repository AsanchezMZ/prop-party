<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PartyMenu.uss?fileID=7433441132597879392&amp;guid=6b4ac884563daa44e9fe4a22b02380d1&amp;type=3#PartyMenu"/>
    <ui:VisualElement name="menu-root" class="party">
        <PartyMenuStage class="menu-stage">
            <ui:VisualElement class="menu-header">
                <ui:Label text="PropParty" class="wordmark"/>
                <ui:Label text="&#10;" class="edition"/>
                <ui:Button name="game-settings-button" text="AJUSTES" tooltip="Ajustes de vídeo y audio de este equipo" class="game-settings-button secondary"/>
                <ui:Button name="face-button" text="TU CARA" tooltip="Captura tu cara para el personaje" class="face-button secondary"/>
                <ui:TextField name="player-name" label="TÚ" value="Player" max-length="24" class="profile"/>
            </ui:VisualElement>
            <ui:VisualElement name="home" enabled="true" class="home-screen" style="display: flex;">
                <ui:VisualElement class="hero">
                    <ui:Label text="PROP" class="title-prop"/>
                    <ui:Label text="PARTY" class="title-party"/>
                    <ui:Label text="Escóndete a plena vista.&#10;Mantente discreto.&#10;Desconfía hasta de las tazas." class="tagline"/>
                    <ui:VisualElement class="home-actions">
                        <ui:Button name="host" text="CREAR PARTIDA     →" class="primary"/>
                        <ui:Button name="join" text="UNIRME A AMIGOS" class="secondary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="prop-art">
                    <ui:VisualElement class="art-orbit"/>
                    <ui:VisualElement class="suspect-box">
                        <ui:VisualElement class="box-tape"/>
                        <ui:VisualElement class="eyes">
                            <ui:VisualElement class="eye"/>
                            <ui:VisualElement class="eye"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="suspect-mug">
                        <ui:VisualElement class="mug-handle"/>
                        <ui:VisualElement class="mug-body">
                            <ui:VisualElement class="mug-rim"/>
                            <ui:VisualElement class="eyes">
                                <ui:VisualElement class="eye"/>
                                <ui:VisualElement class="eye"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="suspect-egg">
                        <ui:VisualElement class="eyes">
                            <ui:VisualElement class="eye"/>
                            <ui:VisualElement class="eye"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="SOY UNA TAZA QUE HABLA!!" class="alibi"/>
                    <ui:Label text="CONFÍA EN NADIE.&#10;ESPECIALMENTE DE LOS MUEBLES." class="art-caption" style="height: 39px; width: 226px; font-size: 20px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="room" class="room-screen" style="display: none;">
                <ui:Label text="¡EMPIEZA LA FIESTA!" class="room-title"/>
                <ui:VisualElement class="room-columns">
                    <ui:VisualElement class="team-panel">
                        <ui:Label name="player-count" text="EL EQUIPO / 00" class="section-label"/>
                        <ui:VisualElement name="roster" class="roster"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="map-panel">
                        <ui:DropdownField name="maps" label="EL ESCENARIO"/>
                        <ui:VisualElement name="map-preview" class="map-preview">
                            <ui:Label text="EL PRÓXIMO ESCONDITE" class="map-tag"/>
                            <ui:Label name="map-title" text="EL PRÓXIMO MAPA" class="map-title"/>
                        </ui:VisualElement>
                        <ui:Label name="map-description" class="map-description"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="room-actions">
                    <ui:Button name="leave" text="←  SALIR" class="quiet"/>
                    <ui:Button name="settings" text="⚙ REGLAS" class="secondary"/>
                    <ui:Button name="ready" text="ESTOY LISTO" class="secondary"/>
                    <ui:Button name="start" text="¡A JUGAR!    →" class="primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="menu-footer">
                <ui:Label name="status" class="status"/>
            </ui:VisualElement>
            <ui:VisualElement name="join-overlay" class="join-overlay" style="display: none;">
                <ui:VisualElement class="join-dialog">
                    <ui:Label text="¿DÓNDE ES&#10;LA FIESTA?" class="dialog-title"/>
                    <ui:Label text="Introduce la IP de quien ha creado la partida." class="dialog-description"/>
                    <ui:TextField name="address" label="DIRECCIÓN IP" value="127.0.0.1"/>
                    <ui:Button name="connect" text="ENTRAR    →" class="primary"/>
                    <ui:Button name="join-back" text="←  VOLVER" class="quiet"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="settings-overlay" class="join-overlay" style="display: none;">
                <ui:VisualElement class="settings-dialog">
                    <ui:Label text="A TU MANERA" class="dialog-title"/>
                    <ui:Label text="Configura la próxima ronda. Todos volverán a confirmar que están listos." class="dialog-description"/>
                    <ui:VisualElement class="settings-grid">
                        <ui:VisualElement class="settings-column settings-column-left">
                            <ui:Label text="EL EQUIPO" class="settings-section"/>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Buscadores" class="setting-title"/>
                                <ui:SliderInt name="setting-hunters" tooltip="Número inicial de buscadores; siempre quedará un escondedor." low-value="1" high-value="16" show-input-field="true" class="setting-slider"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Vidas por escondedor" class="setting-title"/>
                                <ui:SliderInt name="setting-health" low-value="1" high-value="10" show-input-field="true" class="setting-slider"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row setting-switch-row">
                                <ui:Label text="Al ser capturado" class="setting-title"/>
                                <ui:Toggle name="setting-convert" text="Pasar a buscador" class="setting-toggle"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-column">
                            <ui:Label text="EL RELOJ · SEGUNDOS" class="settings-section"/>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Tiempo para esconderse" class="setting-title"/>
                                <ui:SliderInt name="setting-hide" low-value="0" high-value="120" show-input-field="true" class="setting-slider"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Duración de la caza" class="setting-title"/>
                                <ui:SliderInt name="setting-hunt" low-value="30" high-value="900" show-input-field="true" class="setting-slider"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Silbido automático cada…" class="setting-title"/>
                                <ui:SliderInt name="setting-whistle" low-value="5" high-value="120" show-input-field="true" class="setting-slider"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="settings-note" text="Bonos por riesgo y silbidos manuales. Recarga de silbido: 5 s." class="settings-note"/>
                    <ui:VisualElement class="settings-actions">
                        <ui:Button name="settings-back" text="← VOLVER" class="quiet"/>
                        <ui:Button name="settings-apply" text="✓ APLICAR" class="primary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="face-overlay" class="join-overlay" style="display: none;">
                <ui:VisualElement class="face-dialog">
                    <ui:VisualElement class="face-view">
                        <ui:Image name="face-preview" scale-mode="ScaleToFit" class="face-preview"/>
                        <ui:Image name="face-guide" scale-mode="ScaleToFit" picking-mode="Ignore" class="face-guide"/>
                        <ui:Label name="face-placeholder" text="TU CARA&#10;DE PÓQUER." picking-mode="Ignore" class="face-placeholder"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="face-controls">
                        <ui:Label text="PONLE CARA&#10;AL SOSPECHOSO." class="dialog-title"/>
                        <ui:Label text="Centra tu cara y haz la foto. Se guardará para tu personaje y se compartirá una miniatura con la sala." class="dialog-description"/>
                        <ui:DropdownField name="face-device" label="TU WEBCAM"/>
                        <ui:Label name="face-status" class="face-status"/>
                        <ui:Button name="face-enable" text="ACTIVAR CÁMARA" class="secondary"/>
                        <ui:Button name="face-snap" text="¡ESA ES MI CARA!    →" enabled="false" class="primary"/>
                        <ui:Button name="face-back" text="←  VOLVER" class="quiet"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="game-settings-overlay" class="join-overlay" style="display: none;">
                <ui:VisualElement class="settings-dialog game-settings-dialog">
                    <ui:Label text="PONTE A GUSTO" class="dialog-title"/>
                    <ui:Label text="Vídeo y audio de tu equipo. Las reglas de la sala se ajustan por separado." class="dialog-description"/>
                    <ui:VisualElement class="game-settings-tabs">
                        <ui:Button name="game-video-tab" text="VÍDEO" class="secondary game-settings-tab is-selected"/>
                        <ui:Button name="game-audio-tab" text="AUDIO" class="secondary game-settings-tab"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="game-video-page" class="settings-grid game-settings-page">
                        <ui:VisualElement class="settings-column settings-column-left">
                            <ui:VisualElement class="setting-row"><ui:DropdownField name="game-resolution" label="RESOLUCIÓN"/></ui:VisualElement>
                            <ui:VisualElement class="setting-row"><ui:DropdownField name="game-quality" label="CALIDAD GRÁFICA"/></ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Modo de pantalla" class="setting-title"/>
                                <ui:Toggle name="game-fullscreen" text="Pantalla completa sin bordes" class="setting-toggle"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-column">
                            <ui:VisualElement class="setting-row"><ui:DropdownField name="game-fps" label="LÍMITE DE FPS"/></ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Sincronización vertical" class="setting-title"/>
                                <ui:Toggle name="game-vsync" text="Activar VSync" class="setting-toggle"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="game-audio-page" class="game-settings-page" style="display: none;">
                        <ui:VisualElement class="setting-row">
                            <ui:Label text="Volumen general · %" class="setting-title"/>
                            <ui:SliderInt name="game-master" tooltip="Volumen de todo el juego" low-value="0" high-value="100" show-input-field="true" class="setting-slider"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="setting-row">
                            <ui:Label text="Música · %" class="setting-title"/>
                            <ui:SliderInt name="game-music" low-value="0" high-value="100" show-input-field="true" class="setting-slider"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="setting-row">
                            <ui:Label text="Efectos, interfaz y ambiente · %" class="setting-title"/>
                            <ui:SliderInt name="game-effects" low-value="0" high-value="100" show-input-field="true" class="setting-slider"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="game-settings-note" class="settings-note"/>
                    <ui:VisualElement class="settings-actions">
                        <ui:Button name="game-settings-back" text="← VOLVER" tooltip="Cerrar sin aplicar los cambios pendientes" class="quiet"/>
                        <ui:Button name="game-settings-apply" text="APLICAR" class="primary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </PartyMenuStage>
    </ui:VisualElement>
</ui:UXML>
