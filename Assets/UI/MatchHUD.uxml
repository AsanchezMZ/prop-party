<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MatchHUD.uss" />
    <ui:VisualElement name="hud-root" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="blackout" class="blackout" picking-mode="Ignore" style="display: none;">
            <ui:Label text="PREPARA LA PUNTERÍA" class="blackout-kicker"/>
            <ui:Label text="LA CAZA&#10;ESTÁ A PUNTO" class="blackout-title"/>
            <ui:Label name="release-timer" text="00" class="release-timer"/>
            <ui:Label text="Los escondedores están buscando su sitio." class="blackout-copy"/>
            <ui:Label text="MOVIMIENTO Y DISPARO BLOQUEADOS HASTA LA SALIDA" class="blackout-kicker"/>
        </ui:VisualElement>
        <ui:VisualElement name="risk-halo" class="risk-halo" picking-mode="Ignore"/>
        <ui:VisualElement name="hit-flash" class="hit-flash" picking-mode="Ignore"/>
        <ui:VisualElement class="top-bar" picking-mode="Ignore">
            <ui:Label name="role" text="🎭 PROP PARTY" class="chip role-chip"/>
            <ui:Label name="timer" text="⏱ 00:00" class="chip timer-chip"/>
            <ui:Label name="health" text="❤ —" class="chip health-chip"/>
            <ui:Label name="score" text="⭐ 0" class="chip score-chip"/>
            <ui:Label name="risk" text="🌿 Tranquilo" class="chip risk-chip"/>
            <ui:Button name="whistle" text="🎵 Silbar [G]" class="chip whistle-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore"/>
        <ui:Label name="target-prop" class="target-prop" picking-mode="Ignore" style="display: none;"/>
        <ui:VisualElement name="toasts" class="toasts" picking-mode="Ignore"/>
        <ui:Label name="hint" class="hint" picking-mode="Ignore"/>
        <ui:VisualElement name="actions" class="pause-overlay" style="display: none;">
            <ui:VisualElement class="pause-panel">
                <ui:Label name="result" text="🎉 TIEMPO MUERTO" class="panel-title"/>
                <ui:Label name="result-team" class="result-team" style="display: none;"/>
                <ui:Label text="⭐ PUNTOS DE ESTA RONDA" class="leaderboard-title"/>
                <ui:VisualElement name="leaderboard" class="leaderboard"/>
                <ui:VisualElement class="action-row">
                    <ui:Button name="resume" text="▶ SEGUIR [Tab]" class="mint"/>
                    <ui:Button name="replay" text="🔄 OTRA RONDA" class="yellow"/>
                </ui:VisualElement>
                <ui:VisualElement class="action-row">
                    <ui:Button name="lobby" text="🏠 VOLVER A LA SALA" class="mint"/>
                    <ui:Button name="leave" text="👋 DESCONECTAR" class="coral"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
